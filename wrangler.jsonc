/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tvbot",
	"main": "src/index.ts",
	"compatibility_date": "2025-12-05",
	"observability": {
		"enabled": true
	},
	/**
   * Smart Placement
   * Docs: https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
   */
	// "placement": { "mode": "smart" }
	/**
   * Bindings
   * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
   * databases, object storage, AI inference, real-time communication and more.
   * https://developers.cloudflare.com/workers/runtime-apis/bindings/
   */
	/**
   * D1 Database — defined per environment below
   * https://developers.cloudflare.com/d1/
   */
	"env": {
		"dev": {
			"name": "tvbot-dev",
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "tvbot-db-dev",
					"database_id": "1ac4c0b9-e9f3-4045-bfed-8be2cff9eb9c"
				}
			]
		},
		"prod": {
			"name": "tvbot-prod",
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "tvbot-db-prod",
					"database_id": "694579ba-92f5-4a55-bce6-34c3ac6f6877"
				}
			],
			"triggers": {
				"crons": [
					"* * * * *",
					"0 */4 * * *",
					"0 5 * * *",
					"0 8 * * *"
				]
			}
		}
	}
}
