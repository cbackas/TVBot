{
  "name": "tvbot2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy --env dev",
    "deploy:prod": "wrangler deploy --env prod",
    "dev": "wrangler dev --env dev",
    "start": "wrangler dev --env dev",
    "test": "vitest",
    "cf-typegen": "wrangler types --env dev",
    "biome:fix": "biome check --write --unsafe",
    "biome:check": "biome check",
    "biome:ci": "biome ci",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:migrate-mongo": "tsx scripts/migrate-from-mongo.ts",
    "register-commands": "tsx --import ./scripts/cloudflare-shim.ts --env-file=.env scripts/register-commands.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@cloudflare/vitest-pool-workers": "^0.8.19",
    "drizzle-kit": "^1.0.0-beta.15-859cf75",
    "mongodb": "^7.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.5.2",
    "vitest": "~3.2.0",
    "wrangler": "^4.90.0"
  },
  "dependencies": {
    "city-timezones": "^1.3.3",
    "discord-api-types": "^0.38.36",
    "discord-interactions": "^4.4.0",
    "drizzle-orm": "^1.0.0-beta.15-859cf75",
    "moment-timezone": "^0.6.0",
    "parse-url": "^10.0.3",
    "zod": "^4.3.6"
  }
}
